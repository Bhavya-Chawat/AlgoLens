# All optional. End users enter their own free Groq key in the app (Settings).
PORT=3000
HOST=127.0.0.1

# Dev convenience only: used when the browser sends no key.
# GROQ_API_KEY=gsk_...

# Force a specific Groq model instead of auto-discovery.
# GROQ_MODEL=openai/gpt-oss-120b

# Accounts and saved runs (SQLite file, created on first use; needs Node 22.13+)
# ALGOLENS_DB=./data/algolens.db
# Make the app (and every API call) require an account:
# ALGOLENS_REQUIRE_LOGIN=1
# ALGOLENS_ALLOW_REGISTRATION=0
# ALGOLENS_SESSION_DAYS=30
# AI "Explain" calls per signed-in user per day:
# ALGOLENS_AI_DAILY_LIMIT=40

# Hosting for many people (behind HTTPS and a proxy):
# HOST=0.0.0.0
# ALLOWED_ORIGINS=https://your-domain.example
# ALGOLENS_SECURE_COOKIES=1
# ALGOLENS_TRUST_PROXY=1
